<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Blobs</RootNamespace>
    <PackageId>Stellaegis.Blobs</PackageId>
    <Description>A storage abstraction for opaque binary content: IBlobStore, addressed by holder, blob space and key. The storage backend is chosen by the adapter registered.</Description>
    <PackageTags>stellaegis;blobs;storage;object-storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellaegis.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Stellaegis.Primitives" />
  </ItemGroup>

</Project>
