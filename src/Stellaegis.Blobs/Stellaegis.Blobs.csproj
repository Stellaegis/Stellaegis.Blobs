<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Blobs</RootNamespace>
    <PackageId>Stellaegis.Blobs</PackageId>
    <Description>Stellaegis blob storage abstraction: a provider-agnostic IBlobStore over opaque binary content, isolated per tenant. Shared by the document (GED) and trash domains. Adapters (filesystem, S3, Azure Blob) live in companion packages.</Description>
    <PackageTags>stellaegis;blobs;storage;object-storage;multi-tenant</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellaegis.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Stellaegis.Primitives" />
  </ItemGroup>

</Project>
